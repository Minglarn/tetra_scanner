MODE=scanner
SCAN_START_MHZ=420
SCAN_END_MHZ=430
IDLE_TIMEOUT_SEC=900      # 15 minuter utan riktig trafik triggar ett nytt svep
BLACKLIST_STRIKES=3       # Antal Idle Timeouts på samma frekvens innan den svartlistas
BLACKLIST_TIME_SEC=3600   # Hur länge en frekvens ignoreras efter 3 strikes (default 1 timme)

WEB_PORT=8080

RTL_DEVICE_INDEX=1
RTL_GAIN=24.0
RTL_PPM=0
CENTER_FREQ=427750000
TETRA_CHANNELS=427000000:71,427300000:17,427550000:23,427850000:1,427950000:16,428500000:7

MQTT_ENABLED=true
MQTT_HOST=192.168.1.121
MQTT_PORT=1883
MQTT_USER=home-assistant-server
MQTT_PASS=bytmig
MQTT_BASE_TOPIC=tetra/240_11
HA_DISCOVERY_ENABLED=true
HA_DISCOVERY_PREFIX=homeassistant

UDP_OUT_ENABLED=false
UDP_OUT_TARGETS=192.168.1.10:5555
UDP_OUT_INCLUDE_RAW=false

HOST_NAME=iridium
LOG_DIR=/app/logs
